{% extends template('theme/base.html.twig') %}
{% trans_default_domain 'EnhavoUserBundle' %}

{% block main %}
    <div data-controller="form" data-form-form-value="{{ form|json_encode|e }}">
        <form-form :form="form">
            <form-row :form="form.get('userIdentifier')"></form-row>
            <form-row :form="form.get('_token')"></form-row>
            <button type="submit">{{ 'reset_password.request.submit'|trans|nl2br }}</button>
            <a href="{{ path('enhavo_user_theme_login') }}">{{ 'reset_password.label.login'|trans|nl2br }}</a>
        </form-form>
    </div>
{% endblock main %}
